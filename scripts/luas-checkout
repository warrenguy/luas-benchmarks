#!/usr/bin/env bash
# Check out the Luas commit that go.mod names in .cache/luas. Clone Luas
# first when .cache/luas is not a clone. Fetch when the commit is missing.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DEST="${ROOT}/.cache/luas"
REPOSITORY=https://github.com/warrenguy/luas.git

version="$(cd "${ROOT}" && GOWORK=off go list -m -f '{{.Version}}' github.com/warrenguy/luas)"
commit="${version##*-}"
if [[ ! "${commit}" =~ ^[0-9a-f]{12}$ ]]; then
	echo "luas-checkout: go.mod luas version ${version}: want a pseudo-version" >&2
	exit 1
fi

if [[ ! -d "${DEST}/.git" ]]; then
	mkdir -p "$(dirname "${DEST}")"
	git clone --quiet "${REPOSITORY}" "${DEST}"
fi
if ! git -C "${DEST}" cat-file -e "${commit}^{commit}" 2>/dev/null; then
	git -C "${DEST}" fetch --quiet origin
fi
if [[ "$(git -C "${DEST}" rev-parse HEAD 2>/dev/null)" != "${commit}"* ]]; then
	git -C "${DEST}" -c advice.detachedHead=false checkout --quiet --detach "${commit}"
fi
echo "luas-checkout: ${DEST} at $(git -C "${DEST}" rev-parse --short=12 HEAD)"
